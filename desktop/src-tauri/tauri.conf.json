{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CORVAX",
  "identifier": "dev.corvax.desktop",
  "version": "0.1.0",
  "build": { "frontendDist": "../web" },
  "app": {
    "windows": [
      { "label": "node", "url": "node.html", "visible": false, "width": 10, "height": 10,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows" },
      { "label": "ui", "title": "CORVAX", "url": "http://127.0.0.1:4799/", "visible": false, "width": 760, "height": 900 }
    ],
    "withGlobalTauri": true,
    "trayIcon": { "iconPath": "icons/tray.png", "tooltip": "CORVAX node" },
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
